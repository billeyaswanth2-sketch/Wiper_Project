{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/washer_wiper_project",
                "-B",
                "${workspaceFolder}/washer_wiper_project/build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_C_COMPILER=C:/msys64/mingw64/bin/gcc.exe",
                "-DCMAKE_CXX_COMPILER=C:/msys64/mingw64/bin/g++.exe"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/washer_wiper_project/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Washer Wiper Tests",
            "type": "shell",
            "command": "${workspaceFolder}/washer_wiper_project/build/test/Washer_wiperTest.exe",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "CMake Build",
            "problemMatcher": []
        }
    ]
}